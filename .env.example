# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional client-side reCAPTCHA Enterprise site key
VITE_RECAPTCHA_ENTERPRISE_KEY="6LfdM_osAAAAACYD8TKknkLxm1mFJ2pHxqjZsPTS"

# Google Cloud API Key for server-side reCAPTCHA Enterprise verification
# (If not provided, the system will gracefully fallback to GEMINI_API_KEY if available)
RECAPTCHA_API_KEY="your-google-cloud-api-key"

# Google Cloud Project ID for reCAPTCHA Enterprise verification
RECAPTCHA_PROJECT_ID="your-google-cloud-project-id"

# SMTP Configuration for Login Access Alerts (sent to alibabamosu@gmail.com)
# Enter these keys in the Secrets panel in AI Studio:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

